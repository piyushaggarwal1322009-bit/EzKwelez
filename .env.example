# ==============================================================================
# EzyKwelez Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or .env.local for Next.js) and fill in your values.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Supabase Integration (Auth & Persistence)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# AI Provider Configuration (Engine Adapter)
# ------------------------------------------------------------------------------
# Options: mock, openai, gemini, anthropic
AI_PROVIDER=mock
AI_API_KEY=
