{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "bg": {
      "base": { "value": "#090d16", "description": "Primary viewport canvas background" },
      "surface": { "value": "#0f172a", "description": "Standard card, table, and panel surface" },
      "elevated": { "value": "#1e293b", "description": "Elevated modal, dropdown, and active card surface" },
      "subtle": { "value": "#131d33", "description": "Subtle alternate row, input field background" },
      "backdrop": { "value": "rgba(9, 13, 22, 0.75)", "description": "Modal and drawer backdrop overlay" }
    },
    "border": {
      "subtle": { "value": "#1e293b", "description": "Hairline boundary for cards and rows" },
      "strong": { "value": "#334155", "description": "Elevated boundaries, active cards, and input borders" },
      "accent": { "value": "#3b82f6", "description": "Selected state indicator border" },
      "focus": { "value": "#38bdf8", "description": "Visible keyboard focus ring" },
      "disabled": { "value": "#1e293b", "description": "Disabled element border" }
    },
    "text": {
      "primary": { "value": "#f8fafc", "description": "High-contrast headings, active values, and primary text" },
      "secondary": { "value": "#94a3b8", "description": "Labels, descriptions, and secondary metadata" },
      "muted": { "value": "#64748b", "description": "Timestamps, column headers, and helper text" },
      "inverse": { "value": "#090d16", "description": "Text rendered over bright status fills or brand buttons" },
      "disabled": { "value": "#475569", "description": "Disabled input and button labels" }
    },
    "brand": {
      "primary": { "value": "#2563eb", "description": "Primary brand color for buttons and active states" },
      "accent": { "value": "#0ea5e9", "description": "Secondary brand accent for highlights and active navigation" },
      "subtle": { "value": "rgba(37, 99, 235, 0.15)", "description": "Selected item background tint" }
    },
    "status": {
      "critical": {
        "value": "#ef4444",
        "bg": { "value": "rgba(239, 68, 68, 0.12)" },
        "border": { "value": "rgba(239, 68, 68, 0.35)" },
        "text": { "value": "#fca5a5" },
        "description": "High/Critical severity, direct failures, blocked resources"
      },
      "warning": {
        "value": "#f59e0b",
        "bg": { "value": "rgba(245, 158, 11, 0.12)" },
        "border": { "value": "rgba(245, 158, 11, 0.35)" },
        "text": { "value": "#fde68a" },
        "description": "Moderate severity, degraded capacity, approaching threshold"
      },
      "success": {
        "value": "#10b981",
        "bg": { "value": "rgba(16, 185, 129, 0.12)" },
        "border": { "value": "rgba(16, 185, 129, 0.35)" },
        "text": { "value": "#6ee7b7" },
        "description": "Optimal recovery score, fully operational, resolved disruption"
      },
      "info": {
        "value": "#38bdf8",
        "bg": { "value": "rgba(56, 189, 248, 0.12)" },
        "border": { "value": "rgba(56, 189, 248, 0.35)" },
        "text": { "value": "#bae6fd" },
        "description": "Counterfactual simulation mode, advisory notice, system info"
      },
      "neutral": {
        "value": "#64748b",
        "bg": { "value": "rgba(100, 116, 139, 0.12)" },
        "border": { "value": "rgba(100, 116, 139, 0.35)" },
        "text": { "value": "#cbd5e1" },
        "description": "Draft incident, unassigned entity, inactive state"
      },
      "focus": {
        "value": "#38bdf8",
        "description": "Universal high-contrast focus indicator token"
      },
      "disabled": {
        "value": "rgba(148, 163, 184, 0.38)",
        "bg": { "value": "rgba(30, 41, 59, 0.4)" },
        "text": { "value": "#475569" },
        "description": "Disabled state token for non-interactive elements"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
      "mono": { "value": "JetBrains Mono, Menlo, 'Courier New', monospace" }
    },
    "fontSize": {
      "xs": { "value": "11px", "rem": "0.6875rem", "description": "Micro labels, status badges, table caps" },
      "sm": { "value": "12px", "rem": "0.75rem", "description": "Captions, timestamps, secondary metadata" },
      "base": { "value": "14px", "rem": "0.875rem", "description": "Default body text, form inputs, table cells" },
      "md": { "value": "15px", "rem": "0.9375rem", "description": "Card titles, navigation labels, button labels" },
      "lg": { "value": "18px", "rem": "1.125rem", "description": "Section headers, modal titles" },
      "xl": { "value": "24px", "rem": "1.5rem", "description": "Primary page title" },
      "2xl": { "value": "32px", "rem": "2.0rem", "description": "Display metrics, primary KPI numbers" }
    },
    "fontWeight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "semibold": { "value": "600" },
      "bold": { "value": "700" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "snug": { "value": "1.33" },
      "normal": { "value": "1.43" },
      "relaxed": { "value": "1.5" }
    },
    "letterSpacing": {
      "tight": { "value": "-0.02em" },
      "snug": { "value": "-0.01em" },
      "normal": { "value": "0em" },
      "wide": { "value": "+0.01em" },
      "wider": { "value": "+0.03em" }
    }
  },
  "spacing": {
    "0": { "value": "0px" },
    "1": { "value": "4px", "description": "Micro gap (badge icon to text, compact tags)" },
    "2": { "value": "8px", "description": "Tight element spacing, button py sm, stack gap" },
    "3": { "value": "12px", "description": "Form input py, card internal item gap" },
    "4": { "value": "16px", "description": "Standard container padding, button px, card body gap" },
    "5": { "value": "20px", "description": "Sub-section gap, toolbar spacing" },
    "6": { "value": "24px", "description": "Standard card padding, grid gap between dashboard widgets" },
    "8": { "value": "32px", "description": "Major section separator gap" },
    "10": { "value": "40px", "description": "Hero section margin, drawer header separation" },
    "12": { "value": "48px", "description": "Page area divider" },
    "16": { "value": "64px", "description": "Outer viewport gutters on wide monitors" }
  },
  "radius": {
    "none": { "value": "0px" },
    "sm": { "value": "2px", "description": "Badges, micro status tags" },
    "md": { "value": "4px", "description": "Buttons, inputs, dropdown items, table rows" },
    "lg": { "value": "6px", "description": "Operational cards, panels, sidebars" },
    "xl": { "value": "8px", "description": "Modals, command palette dialog" },
    "full": { "value": "9999px", "description": "Pill indicators, avatar rings" }
  },
  "elevation": {
    "0": {
      "surface": { "value": "#090d16" },
      "border": { "value": "1px solid transparent" },
      "shadow": { "value": "none" }
    },
    "1": {
      "surface": { "value": "#0f172a" },
      "border": { "value": "1px solid #1e293b" },
      "shadow": { "value": "0 1px 3px 0 rgba(0, 0, 0, 0.4)" }
    },
    "2": {
      "surface": { "value": "#1e293b" },
      "border": { "value": "1px solid #334155" },
      "shadow": { "value": "0 4px 12px 0 rgba(0, 0, 0, 0.6)" }
    },
    "3": {
      "surface": { "value": "#1a2333" },
      "border": { "value": "1px solid #334155" },
      "shadow": { "value": "0 12px 32px 0 rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05)" }
    }
  },
  "breakpoint": {
    "sm": { "value": "640px" },
    "md": { "value": "768px" },
    "lg": { "value": "1024px" },
    "xl": { "value": "1280px" },
    "2xl": { "value": "1536px" }
  },
  "motion": {
    "duration": {
      "fast": { "value": "100ms", "description": "Micro-interactions, button active states, tooltip fade" },
      "normal": { "value": "200ms", "description": "Dropdowns, accordions, toast appearances" },
      "slow": { "value": "300ms", "description": "Drawer slides, modal transitions, blast radius waves" }
    },
    "easing": {
      "easeOut": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "description": "Entering elements, drawers opening" },
      "easeInOut": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "description": "Morphing layout containers, tab transitions" }
    }
  }
}
